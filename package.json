{
  "name": "high-human-lab-visual-editor",
  "productName": "HIGH HUMAN LAB — VISUAL EDITOR",
  "version": "0.2.1",
  "description": "Experimental video editing workstation for musicians and visual artists.",
  "type": "module",
  "main": "src/main/boot.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@fugood/whisper.node": "^1.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "lab.highhuman.visualeditor",
    "productName": "HIGH HUMAN LAB - VISUAL EDITOR",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/@fugood/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "hhlab",
        "name": "HIGH HUMAN LAB project",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "HIGH-HUMAN-LAB-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "HIGH HUMAN LAB"
}
